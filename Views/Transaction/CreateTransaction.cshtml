@model TaskUIS.ViewModels.TransactionProductViewModel

<h2>Create Transaction</h2>

<form id="transactionForm">
    <table id="productsTable" class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <select class="form-control productId" name="Products[0].ProductId">
                        <option value="">-- Select Product --</option>
                        @foreach (var product in Model.ProductList)
                        {
                            <option value="@product.Value">@product.Text</option>
                        }
                    </select>
                </td>
                <td><input type="number" class="form-control quantity" name="Products[0].Quantity" required min="1" value="1" /></td>
                <td><input type="text" class="form-control unitPrice" name="Products[0].UnitPrice" readonly /></td>
                <td><input type="text" class="form-control lineTotal" name="Products[0].Total" readonly /></td>
                <td><button type="button" class="btn btn-danger btn-sm removeRow">X</button></td>
            </tr>
        </tbody>
    </table>

    <div class="form-group">
        <label class="font-weight-bold">Total Invoice Price:</label>
        <input type="text" class="form-control" id="TotalInvoicePrice" name="TotalInvoicePrice" readonly />
    </div>

    <div class="mt-3">
        <button type="button" id="addRow" class="btn btn-secondary">Add Product</button>
        <button type="submit" class="btn btn-primary">Submit Transaction</button>
    </div>
</form>

<div id="result" class="mt-3"></div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    $(document).on('change', '.productId', function() {
        const productId = $(this).val();
        const row = $(this).closest('tr');
        if (productId) {
            fetchProductPrice(productId, row);
        } else {
            row.find('.unitPrice').val('');
            recalculateRowTotal(row);
        }
    });

    $(document).on('input', '.quantity', function() {
        recalculateRowTotal($(this).closest('tr'));
    });

    $(document).on('click', '.removeRow', function() {
        $(this).closest('tr').remove();
        updateRowIndices();
        calculateTotalInvoice();
    });

    $('#addRow').click(function() {
        const index = $('#productsTable tbody tr').length;
        const newRow = $(`
            <tr>
                <td>
                    <select class="form-control productId" name="Products[${index}].ProductId">
                        <option value="">-- Select Product --</option>
                        @foreach (var product in Model.ProductList)
                        {
                            <option value="@product.Value">@product.Text</option>
                        }
                    </select>
                </td>
                <td><input type="number" class="form-control quantity" name="Products[${index}].Quantity" required min="1" value="1" /></td>
                <td><input type="text" class="form-control unitPrice" name="Products[${index}].UnitPrice" readonly /></td>
                <td><input type="text" class="form-control lineTotal" name="Products[${index}].Total" readonly /></td>
                <td><button type="button" class="btn btn-danger btn-sm removeRow">X</button></td>
            </tr>
        `);

        $('#productsTable tbody').append(newRow);
    });

    function fetchProductPrice(productId, row) {
        $.get('@Url.Action("GetProductPrice", "Transaction")', { productId: productId })
            .done(function(response) {
                if (response.success) {
                    row.find('.unitPrice').val(response.price);
                    recalculateRowTotal(row);
                }
            })
            .fail(function() {
                alert('Error fetching product price');
            });
    }

    function recalculateRowTotal(row) {
        const quantity = parseFloat(row.find('.quantity').val()) || 0;
        const unitPrice = parseFloat(row.find('.unitPrice').val()) || 0;
        const lineTotal = quantity * unitPrice;
        row.find('.lineTotal').val(lineTotal.toFixed(2));
        calculateTotalInvoice();
    }

    function calculateTotalInvoice() {
        let total = 0;
        $('.lineTotal').each(function() {
            total += parseFloat($(this).val()) || 0;
        });
        $('#TotalInvoicePrice').val(total.toFixed(2));
    }

    function updateRowIndices() {
        $('#productsTable tbody tr').each(function(index) {
            $(this).find('.productId').attr('name', `Products[${index}].ProductId`);
            $(this).find('.quantity').attr('name', `Products[${index}].Quantity`);
            $(this).find('.unitPrice').attr('name', `Products[${index}].UnitPrice`);
            $(this).find('.lineTotal').attr('name', `Products[${index}].Total`);
        });
    }

    $('#transactionForm').submit(function(e) {
        e.preventDefault();

        $.post('@Url.Action("CreateTransaction", "Transaction")', $(this).serialize())
            .done(function(response) {
                const alertType = response.success ? 'alert-success' : 'alert-danger';
                $('#result').html(`<div class="alert ${alertType}">${response.message}</div>`);

                if (response.success) {
                    setTimeout(() => window.location.href = response.redirectUrl, 1500);
                }
            })
            .fail(function() {
                $('#result').html('<div class="alert alert-danger">Error processing request</div>');
            });
    });

    calculateTotalInvoice();
    </script>
}
