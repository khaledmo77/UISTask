@model TaskUIS.ViewModels.TransactionOverviewViewModel

@{
    ViewBag.Title = "Transaction Overview";
}

<h2>Transaction Overview</h2>

<form id="filterForm">
    <div class="form-group">
        <label for="filterDate">Filter by Date:</label>
        <input type="date" id="filterDate" name="filterDate" class="form-control" value="@Model.FilterDate?.ToString(" yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
</form>
<p>
    @Html.ActionLink("Create Transactions", "CreateTransaction", "Transaction", null, new { @class = "btn btn-primary" })
</p>


<table class="table mt-4">
    <thead>
        <tr>
            <th>Transaction ID</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total Price</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="transactionTableBody">
        @foreach (var transaction in Model.Transactions)
        {
            <tr>
                <td>@transaction.Id</td>
                <td>@transaction.Quantity</td>
                <td>@transaction.UnitPrice.ToString("C2")</td>
                <td>@transaction.TotalPrice.ToString("C2")</td>
                <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                <td>
                    <button class="btn btn-info btn-sm view-details" data-id="@transaction.Id">View Details</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="transactionModal" tabindex="-1" role="dialog" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Transaction Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="transactionDetailsContent">

            </div>
        </div>
    </div>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        // Filter by date
        $('#filterForm').submit(function (event) {
            event.preventDefault();
            var filterDate = $('#filterDate').val();

            $.ajax({
                url: '@Url.Action("Index", "Transaction")',
                type: 'GET',
                data: { startDate: filterDate },
                success: function (data) {
                    $('#transactionTableBody').html(data);
                },
                error: function (error) {
                    console.error("Error:", error);
                }
            });
        });

        // View details
        $(document).on('click', '.view-details', function () {
            var transactionId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("GetTransactionById", "Transaction")',
                type: 'GET',
                data: { transactionId: transactionId },
                success: function (response) {
                    if (response.success) {
                        var transaction = response.transaction;
                        var html = `
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5>Transaction #${transaction.TransactionId}</h5>
                                    <p>Date: ${new Date(transaction.FormattedDate).toLocaleDateString()}</p>
                                </div>
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Products:</h6>
                                    <ul class="list-group mb-3">`;

                        transaction.Products.forEach(function (product) {
                            html += `
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    ${product.Name}
                                    <span>
                                        Qty: ${product.Quantity} | Unit Price: $${product.UnitPrice.toFixed(2)}
                                    </span>
                                </li>`;
                        });

                        html += `
                                    </ul>
                                    <p><strong>Total Quantity:</strong> ${transaction.Quantity}</p>
                                    <p><strong>Total Price:</strong> $${transaction.TotalPrice.toFixed(2)}</p>
                                </div>
                            </div>
                        `;

                        $('#transactionDetailsContent').html(html);
                        $('#transactionModal').modal('show');
                    } else {
                        alert("Transaction not found.");
                    }
                },
                error: function (error) {
                    console.error("Error fetching details:", error);
                }
            });
        });
    });
</script>
