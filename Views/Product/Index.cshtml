@model IEnumerable<TaskUIS.Models.Product>
@{
    ViewBag.Title = "Index";
}

<div class="container">
    <h1>Products</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
    </p>

    <!-- Search Form -->
    <div class="row mb-3">
        <div class="col-md-12">
            @using (Html.BeginForm("Search", "Product", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search products..." value="" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">Search</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-md-12">
            @using (Html.BeginForm("Filter", "Product", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="row">
                    @*<div class="col-md-4">
                        @Html.DropDownList("categoryId", new SelectList(ViewBag.Categories, "Id", "Name"), "-- Select Category --", new { @class = "form-control" })
                    </div>*@
                    @*<div class="col-md-4">
                        @Html.DropDownList("brandId", new SelectList(ViewBag.Brands, "Id", "Name"), "-- Select Brand --", new { @class = "form-control" })
                    </div>*@
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        @Html.ActionLink("Reset", "Index", null, new { @class = "btn btn-secondary" })
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Product Cards -->
    <div class="row">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">

                        @*@if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="" class="card-img-top" alt="Product Image" style="height: 200px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                                <span class="text-muted">No image available</span>
                            </div>
                        }*@

                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">
                                <strong>Price:</strong> @item.Price <br />
                                <strong>Category:</strong>  <br />
                                <strong>Brand:</strong> 
                            </p>
                        </div>

                        <div class="card-footer">
                            <div class="btn-group">
                                @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info" })
                                @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning" })
                                @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger" })
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-md-12">
                <div class="alert alert-info">No products found.</div>
            </div>
        }
    </div>

    <!-- Pagination Placeholder -->
    <div class="row">
        <div class="col-md-12 text-center">
            <div class="pagination">
                @* Uncomment and implement pagination logic if needed
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        @Html.ActionLink(i.ToString(), "Index", new { page = i }, new { @class = "btn btn-outline-secondary" })
                    }
                *@
            </div>
        </div>
    </div>
</div>

<!-- JS Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
