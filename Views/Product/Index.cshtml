
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>




<div class="container">
    <h1>Products</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


        <p>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </p>



    <div class="row mb-3">
        <div class="col-md-12">
            <form asp-action="Search" method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search products..."
                           value="">
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <form asp-action="Filter" method="get" class="form-inline">
                <div class="row">
                    <div class="col-md-4">
                        <select name="categoryId" class="form-control" asp-items="">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="brandId" class="form-control" asp-items="">
                            <option value="">-- Select Brand --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        <a asp-action="Index" class="btn btn-secondary">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
    
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                 
                        <img src="!.First().ImagePath"
                             class="card-img-top " alt="" style="height: 200px; object-fit:contain ;">
                    
                    else
                    {
                        <div class="card-img-top bg-light"
                             style="height: 200px; display: flex; align-items: center; justify-content: center;">
                            <span class="text-muted">No image available</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title"></h5>
                        <p class="card-text">
                            <strong>Price:</strong>  <br>
                            <strong>Category:</strong> <br>
                            <strong>Brand:</strong>
                        </p>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group">
                            <a asp-action="Details" asp-route-id="" class="btn btn-info">Details</a>
                         
                                <p>
                                    <a asp-action="Edit" asp-route-id="" class="btn btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="" class="btn btn-danger">Delete</a>
                                </p>
                            

                        </div>
                    </div>
                </div>
            </div>
        
    </div>
    <div class="row">
        <div class="col-md-12 text-center">
            <!-- Add pagination controls here -->
            <div class="pagination">
                @*@if (Model.PagedProducts != null && Model.PagedProducts.TotalPages > 1)
                {
                    for (int i = 1; i <= Model.PagedProducts.TotalPages; i++)
                    {
                        <a asp-action="Index" asp-route-page="@i" class="btn btn-outline-secondary">@i</a>
                    }
                }*@
            </div>
        </div>
    </div>

</div>