@model IEnumerable<TaskUIS.Models.Product>
@{
    ViewBag.Title = "Index";
}

<div class="container">
    <h1>Products</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <p>
        @Html.ActionLink("Create New", "AddProduct", null, new { @class = "btn btn-primary" })
    </p>
    <p>
        @Html.ActionLink("Create New Transaction", "AddProduct", null, new { @class = "btn btn-primary" })
    </p>
    <!-- Search Form -->
    <div class="row mb-3">
        <div class="col-md-12">
            @using (Html.BeginForm("Search", "Product", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search products..." value="" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">Search</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-md-12">
            @using (Html.BeginForm("Filter", "Product", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="row">
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        @Html.ActionLink("Reset", "Index", null, new { @class = "btn btn-secondary" })
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Product Cards -->
    <div class="row">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">
                                <strong>Price:</strong> @item.Price <br />
                                <strong>Category:</strong> <br />
                                <strong>Brand:</strong>
                            </p>
                        </div>
                        <div class="card-footer">
                            <div class="btn-group">
                                @*@Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info" })*@
                                @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning" })
                                <button class="btn btn-danger delete-btn" data-product-id="@item.Id" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-md-12">
                <div class="alert alert-info">No products found.</div>
            </div>
        }
    </div>

    <!-- Pagination  -->
    <div class="row">
        <div class="col-md-12 text-center">
            <div class="pagination">

            </div>
        </div>
    </div>
</div>

<!-- Modal for Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this product? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete" asp-controller="Product" method="post">
    <input type="hidden" id="deleteUserId" name="id" />
    @Html.AntiForgeryToken()
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let deleteButtons = document.querySelectorAll(".delete-btn");
        let deleteUserIdInput = document.getElementById("deleteUserId");

       
        deleteButtons.forEach(button => {
            button.addEventListener("click", function () {
                let productId = this.getAttribute("data-product-id");
                deleteUserIdInput.value = productId;
            });
        });

        document.getElementById("confirmDelete").addEventListener("click", function () {
            let productId = deleteUserIdInput.value;

            $.ajax({
                url: '@Url.Action("Delete", "Product")', 
                type: 'POST',
                data: {
                    id: productId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() // Include anti-forgery token
                },
                success: function (response) {
                    if (response.success) {
                  
                        $('#deleteModal').modal('hide');
                        alert(response.message || "Product deleted successfully.");
                        location.reload(); 
                    } else {
                        alert(response.message || "Failed to delete the product.");
                    }
                },
                error: function () {
                    alert("An error occurred while deleting the product.");
                }
            });
        });
    });
</script>
